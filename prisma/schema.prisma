generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String
  phone           String?
  image           String?
  status          String    @default("ACTIVE")
  locale          String    @default("en-GB")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  roles              UserRole[]
  sessions           Session[]
  tokens             AuthToken[]
  customer           CustomerProfile?
  vendor             VendorProfile?
  addresses          Address[]
  notifications      Notification[]
  supportTickets     SupportTicket[]     @relation("TicketRequester")
  assignedTickets    SupportTicket[]     @relation("TicketAssignee")
  auditLogs          AuditLog[]
  reviews            Review[]
  wishlistItems      WishlistItem[]
  carts              Cart[]
  orders             Order[]
  walletEntries      BuyerWalletEntry[]
  payoutDetail       BuyerPayoutDetail?
  buyerPayouts       BuyerPayout[]
  permissionOverrides PermissionOverride[]
  settingChanges     SettingChange[]
  restrictionEvents  AccountRestriction[]  @relation("RestrictionTarget")
  restrictionsApplied AccountRestriction[] @relation("RestrictionActor")
  oauthAccounts      OAuthAccount[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String?
  module      String
  groupName   String @default("general")

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model PermissionOverride {
  id           String    @id @default(cuid())
  userId       String
  permissionKey String
  allowed      Boolean
  reason       String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, permissionKey])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  type      String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountRestriction {
  id          String    @id @default(cuid())
  userId      String
  actorId     String?
  kind        String
  active      Boolean   @default(true)
  reason      String
  createdAt   DateTime  @default(now())
  liftedAt    DateTime?
  user        User      @relation("RestrictionTarget", fields: [userId], references: [id], onDelete: Cascade)
  actor       User?     @relation("RestrictionActor", fields: [actorId], references: [id])
}

model BuyerWalletEntry {
  id             String   @id @default(cuid())
  userId         String
  type           String
  amountPence    Int
  orderId        String?
  idempotencyKey String?  @unique
  note           String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BuyerPayoutDetail {
  id            String @id @default(cuid())
  userId        String @unique
  accountName   String
  sortCode      String
  accountNumber String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BuyerPayout {
  id           String   @id @default(cuid())
  userId       String
  amountPence  Int
  status       String   @default("COMPLETED")
  accountName  String
  sortCode     String
  accountLast4 String
  createdAt    DateTime @default(now())
  processedAt  DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketing Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String  @default("Home")
  line1      String
  line2      String?
  city       String
  region     String?
  postcode   String
  country    String  @default("GB")
  isDefault  Boolean @default(false)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VendorProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  storeName          String
  storeSlug          String    @unique
  storeLogo          String?
  storeBanner        String?
  description        String?
  businessName       String?
  businessEmail      String?
  businessPhone      String?
  country            String    @default("GB")
  city               String?
  postcode           String?
  sellerType         String    @default("INDIVIDUAL")
  companyNumber      String?
  kycStatus          String    @default("UNVERIFIED")
  payoutEligible     Boolean   @default(false)
  canPublish         Boolean   @default(true)
  canAcceptOrders    Boolean   @default(true)
  canEditListings    Boolean   @default(true)
  canUsePromotions   Boolean   @default(false)
  canRequestPayouts  Boolean   @default(true)
  status             String    @default("ACTIVE")
  visibility         String    @default("PUBLIC")
  policies           String?
  returnPolicy       String?
  socialLinks        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycSubmissions KycSubmission[]
  products       Product[]
  vendorOrders   VendorOrder[]
  shippingMethods ShippingMethod[]
  subscriptions  VendorSubscription[]
  ledger         LedgerEntry[]
  payoutMethods  PayoutMethod[]
  withdrawals    WithdrawalRequest[]
}

model KycSubmission {
  id                String   @id @default(cuid())
  vendorId          String
  kind              String   @default("person")
  provider          String   @default("sylmera")
  providerSessionId String?  @unique
  providerStatus    String?
  decision          String?
  hostedUrl         String?
  resultJson        String?
  status            String   @default("PENDING")
  notes             String?
  documentRefs      String   @default("")
  submittedAt       DateTime @default(now())
  reviewedAt        DateTime?
  reviewerId        String?
  vendor            VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model WebhookReceipt {
  id        String   @id
  source    String
  createdAt DateTime @default(now())
}

model Category {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  image         String?
  banner        String?
  seoTitle      String?
  seoDescription String?
  parentId      String?
  sortOrder     Int      @default(0)
  enabled       Boolean  @default(true)
  featured      Boolean  @default(false)
  shippingNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  attributes CategoryAttribute[]
  products   Product[]
}

model CategoryAttribute {
  id         String  @id @default(cuid())
  categoryId String
  key        String
  label      String
  fieldType  String  @default("text")
  required   Boolean @default(false)
  options    String?
  sortOrder  Int     @default(0)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Product {
  id              String   @id @default(cuid())
  vendorId        String
  categoryId      String
  name            String
  slug            String   @unique
  description     String
  status          String   @default("DRAFT")
  rejectionReason String?
  sku             String?
  pricePence      Int
  salePricePence  Int?
  weightGrams     Int?
  lengthMm        Int?
  widthMm         Int?
  heightMm        Int?
  originCountry   String   @default("NG")
  handlingDays    Int      @default(2)
  seoTitle        String?
  seoDescription  String?
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?

  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   Category      @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  attributes ProductAttributeValue[]
  reviews    Review[]
  wishlist   WishlistItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  name       String
  sku        String?
  pricePence Int?
  stock      Int     @default(0)
  options    String?
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements  InventoryMovement[]
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model ProductAttributeValue {
  id        String  @id @default(cuid())
  productId String
  key       String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
}

model InventoryMovement {
  id         String   @id @default(cuid())
  variantId  String
  delta      Int
  reason     String
  note       String?
  createdAt  DateTime @default(now())
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  description     String?
  interval        String
  pricePence      Int
  commissionBps   Int
  maxActiveProducts Int?
  active          Boolean  @default(true)
  openForSignup   Boolean  @default(true)
  autoRenew       Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  subscriptions   VendorSubscription[]
}

model VendorSubscription {
  id                 String    @id @default(cuid())
  vendorId           String
  planId             String
  status             String    @default("ACTIVE")
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  provider           String    @default("sandbox")
  providerSubId      String?
  createdAt          DateTime  @default(now())
  vendor             VendorProfile     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan  @relation(fields: [planId], references: [id])
  billingEvents      BillingEvent[]
}

model BillingEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  type           String
  amountPence    Int      @default(0)
  providerRef    String?
  idempotencyKey String   @unique
  payload        String?
  createdAt      DateTime @default(now())
  subscription   VendorSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model ReminderRule {
  id         String  @id @default(cuid())
  name       String
  eventType  String
  offsetDays Int
  channel    String  @default("EMAIL_AND_INAPP")
  templateId String?
  enabled    Boolean @default(true)
}

model NotificationTemplate {
  id      String @id @default(cuid())
  key     String @unique
  name    String
  subject String
  body    String
  channel String @default("EMAIL")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationDelivery {
  id        String   @id @default(cuid())
  channel   String
  toAddress String
  templateKey String?
  status    String
  error     String?
  createdAt DateTime @default(now())
  metadata  String?
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  guestKey  String?  @unique
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
}

model Order {
  id               String   @id @default(cuid())
  number           String   @unique
  userId           String
  status           String   @default("PENDING_PAYMENT")
  currency         String   @default("GBP")
  subtotalPence    Int
  shippingPence    Int
  taxPence         Int
  discountPence    Int      @default(0)
  totalPence       Int
  paymentStatus    String   @default("UNPAID")
  shippingName     String
  shippingLine1    String
  shippingCity     String
  shippingRegion   String?
  shippingPostcode String
  shippingCountry  String   @default("GB")
  notes            String?
  placedAt         DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
  vendorOrders     VendorOrder[]
  payments         Payment[]
  couponRedemptions CouponRedemption[]
}

model VendorOrder {
  id                  String    @id @default(cuid())
  orderId             String
  vendorId            String
  status              String    @default("PAID")
  subtotalPence       Int
  shippingPence       Int
  taxPence            Int
  commissionBps       Int
  commissionPence     Int
  vendorNetPence      Int
  discountPence       Int       @default(0)
  allocationVersion   Int       @default(1)
  shippingMethodName  String?
  shippingMethodCode  String?
  trackingCarrier     String?
  trackingNumber      String?
  trackingUrl         String?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  customerConfirmedAt DateTime?
  settlementAt        DateTime?
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor              VendorProfile @relation(fields: [vendorId], references: [id])
  items               OrderItem[]
  shipments           Shipment[]
  disputes            Dispute[]
}

model OrderItem {
  id             String  @id @default(cuid())
  vendorOrderId  String
  productId      String
  variantId      String?
  nameSnapshot   String
  skuSnapshot    String?
  quantity       Int
  unitPence      Int
  totalPence     Int
  vendorOrder    VendorOrder    @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String
  provider       String
  providerRef    String?  @unique
  amountPence    Int
  status         String
  idempotencyKey String   @unique
  rawPayload     String?
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ShippingZone {
  id          String @id @default(cuid())
  name        String
  country     String @default("GB")
  postcodePrefixes String
  enabled     Boolean @default(true)
  methods     ShippingMethod[]
}

model ShippingMethod {
  id             String @id @default(cuid())
  vendorId       String?
  zoneId         String
  name           String
  code           String
  carrier        String?
  pricePence     Int
  minDays        Int     @default(2)
  maxDays        Int     @default(5)
  freeAbovePence Int?
  enabled        Boolean @default(true)
  vendor         VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  zone           ShippingZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model Shipment {
  id             String   @id @default(cuid())
  vendorOrderId  String
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  status         String   @default("PREPARING")
  createdAt      DateTime @default(now())
  vendorOrder    VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  events         TrackingEvent[]
}

model TrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  status     String
  message    String
  createdAt  DateTime @default(now())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model LedgerEntry {
  id             String   @id @default(cuid())
  vendorId       String
  vendorOrderId  String?
  type           String
  amountPence    Int
  availableAt    DateTime?
  createdAt      DateTime @default(now())
  note           String?
  vendor         VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model PayoutMethod {
  id        String  @id @default(cuid())
  vendorId  String
  type      String  @default("BANK_UK")
  label     String
  details   String
  isDefault Boolean @default(true)
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id          String   @id @default(cuid())
  vendorId    String
  amountPence Int
  status      String   @default("PENDING")
  feePence    Int      @default(0)
  reviewedBy  String?
  reason      String?
  createdAt   DateTime @default(now())
  processedAt DateTime?
  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Refund {
  id                       String   @id @default(cuid())
  disputeId                String?
  orderId                  String?
  vendorOrderId            String?
  amountPence              Int
  productPence             Int      @default(0)
  shippingPence            Int      @default(0)
  commissionReversalPence  Int      @default(0)
  status                   String
  reason                   String
  idempotencyKey           String?  @unique
  createdAt                DateTime @default(now())
}

model Dispute {
  id            String   @id @default(cuid())
  vendorOrderId String
  type          String
  status        String   @default("OPEN")
  reason        String
  evidenceUrls  String?
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
  vendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?
  body      String
  verified  Boolean  @default(false)
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model SupportTicket {
  id          String   @id @default(cuid())
  number      String   @unique
  requesterId String
  assigneeId  String?
  category    String
  priority    String   @default("NORMAL")
  status      String   @default("OPEN")
  subject     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requester   User     @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee    User?    @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages    TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String
  value          Int
  minSubtotalPence Int     @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int?
  enabled        Boolean   @default(true)
  categoryId     String?
  vendorId       String?
  redemptions    CouponRedemption[]
}

model CouponRedemption {
  id        String @id @default(cuid())
  couponId  String
  orderId   String
  userId    String
  coupon    Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CmsPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  body        String
  seoTitle    String?
  seoDescription String?
  status      String   @default("PUBLISHED")
  updatedAt   DateTime @updatedAt
}

model CmsBanner {
  id        String  @id @default(cuid())
  title     String
  image     String?
  href      String?
  placement String  @default("HOME_HERO")
  enabled   Boolean @default(true)
  sortOrder Int     @default(0)
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model SettingChange {
  id        String   @id @default(cuid())
  key       String
  oldValue  String?
  newValue  String
  actorId   String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
}

model PermissionChangeLog {
  id        String   @id @default(cuid())
  actorId   String?
  targetId  String?
  summary   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  audience  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
